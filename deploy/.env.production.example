# Copy this file to deploy/.env on the server and fill it in there.
#   cp deploy/.env.production.example deploy/.env
#   chmod 600 deploy/.env
# Do not commit deploy/.env. Do not put real secrets in this example.
#
# The API container refuses to start when ANYQ_ENV=production and:
#   - JWT_SECRET or LOGIN_HASH_SECRET is missing, shorter than 32 characters, or a known placeholder
#   - CORS_ORIGINS is empty, contains *, or omits https://DOMAIN
#   - ANYQ_DEMO_PASSWORD is set
#   - DATABASE_URL is missing, is not PostgreSQL, or uses a default password
#   - POSTGRES_PASSWORD is missing or a default
#   - WEB_CONCURRENCY is outside 1–8
# The same rules are in apps/api/docker-entrypoint.sh and deploy/check_env.sh.
# The Python process also refuses a missing or short JWT_SECRET, a missing or short
# LOGIN_HASH_SECRET, and an empty CORS_ORIGINS.

# development or production. This stack requires production.
ANYQ_ENV=production

# HMAC secret for session tokens. Required. At least 32 characters.
# Generate on the server: openssl rand -base64 48
# Empty, short, and placeholder values are rejected (changeme, replace-me,
# test-only, superapp, your-secret, and the same words with different case).
JWT_SECRET=

# Older name, used only when JWT_SECRET is empty. Leave empty.
SUPERAPP_SECRET=

# Separate HMAC secret for the login-failure window. Required. At least 32 characters.
# Generate on the server with a second `openssl rand -base64 48`. Do not reuse JWT_SECRET.
LOGIN_HASH_SECRET=

# Browser origins, comma-separated, no spaces. Must include https://DOMAIN.
# Example: https://example.kz,https://www.example.kz
CORS_ORIGINS=

# PostgreSQL URL. Compose overrides this with the same user, database, and
# POSTGRES_PASSWORD so the API reaches the postgres service. Do not use a
# default password (anyq, postgres, superapp, changeme).
DATABASE_URL=postgresql+psycopg://anyq:replace-with-postgres-password@postgres:5432/anyq

# Password for the postgres service and for DATABASE_URL. Generate on the server:
#   openssl rand -base64 32
# Do not use anyq, postgres, superapp, changeme, password, or secret.
POSTGRES_PASSWORD=

# Paths inside the API container. The anyq-data volume is mounted at /data.
ANYQ_DB_PATH=/data/db.json
ANYQ_UPLOADS_DIR=/data/uploads
ANYQ_DATA_DIR=/data

# Must stay empty in production. Demo passwords are not applied.
ANYQ_DEMO_PASSWORD=

# Version strings written into the personal-data consent log.
LEGAL_PD_VERSION=2026-10-18
LEGAL_PRIVACY_VERSION=2026-10-18
LEGAL_AI_VERSION=2026-10-19

# Published legal markdown, mounted read-only from apps/web/content/legal.
LEGAL_DIR=/app/legal

# Server-side address the web container uses to reach the API.
# Keep this value. The browser calls same-origin /v1, and Caddy routes it.
INTERNAL_API_URL=http://api:8010

# Pilot UI. 1 hides unfinished modules. Any other value shows the full UI.
# Next.js reads this when the web image is built. Changing it needs a rebuild.
NEXT_PUBLIC_PILOT_MODE=1

# Bare hostname for Caddy. No scheme and no path. Example: example.kz
# localhost is only for a local smoke test and uses a local certificate.
DOMAIN=

# Contact address for certificate issuance. Example: admin@example.kz
ACME_EMAIL=

# Listen port inside the API container. Not published on the host.
PORT=8010

# Gunicorn workers. The SQL store is safe with more than one. Allowed range: 1–8.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=50

# The API port is not published. Caddy is the only client on the Docker network.
FORWARDED_ALLOW_IPS=*

# Hourly backup. pg_dump -Fc and the uploads archive are encrypted with age
# and copied to two rclone remotes. Both remotes are storage in Kazakhstan.
# Configure them on the server with `rclone config`. Do not put endpoints or
# access keys in this file. The private age key is not stored here.
BACKUP_DIR=/var/backups/anyq
# Retention is fixed in deploy/backup.sh: hourly copies for 48 hours,
# then 7 daily, 4 weekly, and 6 monthly. Each class is pruned on its own.
AGE_RECIPIENT=
RCLONE_REMOTE_1=<set-on-server>
RCLONE_REMOTE_2=<set-on-server>
RCLONE_DEST_PATH=anyq
# Path to the private key, only on the machine that runs deploy/restore.sh.
# Leave this empty on the server. The path must be outside the repository.
AGE_IDENTITY_FILE=
