# Public site. DOMAIN is a bare hostname (example.kz). Caddy obtains a
# certificate automatically. localhost uses Caddy's local certificate.
{
	email {$ACME_EMAIL}
}

# Local process check. Not published on the host.
http://127.0.0.1:8080 {
	respond "ok" 200
}

{$DOMAIN} {
	encode gzip

	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The token is the next path segment. Access logs keep the route and drop the secret.
	log {
		format filter {
			request>uri regexp "^(/v1/public/rfi/)[^/?]+" "${1}REDACTED"
			request>headers>Referer delete
		}
	}

	# Deferred so this replaces the site policy and the upstream header.
	header /v1/public/rfi* >Referrer-Policy no-referrer

	handle /v1/* {
		reverse_proxy api:8010 {
			transport http {
				response_header_timeout 120s
				read_timeout 130s
				write_timeout 130s
			}
		}
	}

	handle /uploads/* {
		reverse_proxy api:8010
	}

	handle /health {
		reverse_proxy api:8010
	}

	handle /docs {
		reverse_proxy api:8010
	}

	handle /docs/* {
		reverse_proxy api:8010
	}

	handle /redoc {
		reverse_proxy api:8010
	}

	handle /openapi.json {
		reverse_proxy api:8010
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				response_header_timeout 60s
			}
		}
	}
}
