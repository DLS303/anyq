# Public site. DOMAIN is a bare hostname (example.kz). Caddy obtains a
# certificate automatically. localhost uses Caddy's local certificate.
{
	email {$ACME_EMAIL}
}

# Local process check. Not published on the host.
http://127.0.0.1:8080 {
	respond "ok" 200
}

{$DOMAIN} {
	encode gzip

	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://server.arcgisonline.com; connect-src 'self' https://*.tile.openstreetmap.org https://server.arcgisonline.com https://unpkg.com; worker-src 'self' blob: https://unpkg.com; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(self)"
		-Server
	}

	@ready path /v1/health/ready /v1/health/ready/*
	handle @ready {
		respond 404
	}

	handle /v1/* {
		reverse_proxy api:8010 {
			transport http {
				response_header_timeout 120s
				read_timeout 130s
				write_timeout 130s
			}
		}
	}

	handle /uploads/* {
		reverse_proxy api:8010
	}

	handle /health {
		reverse_proxy api:8010
	}

	@api_docs path /docs /docs/* /redoc /redoc/* /openapi.json
	handle @api_docs {
		respond 404
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				response_header_timeout 60s
			}
		}
	}
}
