# Values the API and web actually read. Leave secrets empty. Do not put real data here.

# development, demo, or production.
# demo and production require JWT_SECRET, LOGIN_HASH_SECRET, and CORS_ORIGINS,
# reject * in CORS_ORIGINS, and do not serve API docs.
# production also rejects ANYQ_DEMO_PASSWORD. demo may set it. demo may use SQLite.
ANYQ_ENV=development

# HMAC secret for session tokens. Required in production, at least 32 characters. No default in code.
JWT_SECRET=
# Older name still accepted if JWT_SECRET is empty.
SUPERAPP_SECRET=

# HMAC secret for the login-failure window. Required in production, at least 32 characters.
# Generate separately from JWT_SECRET. No value is stored in this file.
LOGIN_HASH_SECRET=

# Comma-separated browser origins. Required when ANYQ_ENV is demo or production.
# The demo deployment uses the Vercel origin: https://anyq-demo.vercel.app
# * is rejected for demo and production. The startup error names CORS_ORIGINS and does not print the value.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Empty uses a SQLite file next to ANYQ_DB_PATH. Production uses PostgreSQL:
# postgresql+psycopg://anyq:password@postgres:5432/anyq
DATABASE_URL=

# JSON file used by the one-time import, and the base path for the local SQLite file.
# Empty uses data/db.json next to the repo (SQLite becomes data/db.sqlite).
ANYQ_DB_PATH=
# Uploaded files. Empty uses data/uploads.
ANYQ_UPLOADS_DIR=

# Password for @demo.superapp accounts. Read from the environment only. Do not commit a value.
# Applied when ANYQ_DEMO_MODE is on. There is no fallback in code.
# Allowed when ANYQ_ENV=demo; if it is empty, seed data is created and login does not work.
# Forbidden when ANYQ_ENV=production.
ANYQ_DEMO_PASSWORD=

# Fictional seed data and illustrations. Off for a production start: empty database,
# then the first registration becomes the owner. Set to 1 only for a local demo.
ANYQ_DEMO_MODE=0
NEXT_PUBLIC_ANYQ_DEMO_MODE=0

# Version string written into the personal-data consent log.
LEGAL_PD_VERSION=2026-10-18
# Directory with the published legal markdown. Empty uses the repo legal/ folder.
LEGAL_DIR=

# Server-side base URL the Next.js app uses to reach the API. The browser calls same-origin /v1.
INTERNAL_API_URL=http://127.0.0.1:8010

# Short construction navigation: objects, estimate, chat, cabinet.
# The object screen includes the procurement tab (material request, supplier prices, repeat order).
# 1 is the release layout. Illustrations stay off unless ANYQ_DEMO_MODE=1.
# Next.js reads this at build and dev start.
NEXT_PUBLIC_PILOT_MODE=1
