# Values the API and web actually read. Leave secrets empty. Do not put real data here.

# development or production. production refuses to start without JWT_SECRET and CORS_ORIGINS.
ANYQ_ENV=development

# HMAC secret for session tokens. Required in production, at least 32 characters. No default in code.
JWT_SECRET=
# Older name still accepted if JWT_SECRET is empty.
SUPERAPP_SECRET=

# HMAC secret for the login-failure window. Required when ANYQ_ENV=production
# or APP_ENV=prod, at least 32 characters. The process checks this at startup.
# Development and demo start when this is empty. No value is stored in this file.
LOGIN_HASH_SECRET=

# Comma-separated browser origins. Required in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Empty uses a SQLite file next to ANYQ_DB_PATH. Production uses PostgreSQL:
# postgresql+psycopg://anyq:password@postgres:5432/anyq
DATABASE_URL=

# JSON file used by the one-time import, and the base path for the local SQLite file.
# Empty uses data/db.json next to the repo (SQLite becomes data/db.sqlite).
ANYQ_DB_PATH=
# Uploaded files. Empty uses data/uploads.
ANYQ_UPLOADS_DIR=

# Optional password for local @demo.superapp accounts. Ignored when ANYQ_ENV=production.
# Applied only when ANYQ_DEMO_MODE is on.
ANYQ_DEMO_PASSWORD=

# Fictional seed data and illustrations. Off for a production start: empty database,
# then the first registration becomes the owner. Set to 1 only for a local demo.
ANYQ_DEMO_MODE=0
NEXT_PUBLIC_ANYQ_DEMO_MODE=0

# Version string written into the personal-data consent log.
LEGAL_PD_VERSION=2026-10-18
# Directory with the published legal markdown. Empty uses the repo legal/ folder.
LEGAL_DIR=

# Server-side base URL the Next.js app uses to reach the API. The browser calls same-origin /v1.
INTERNAL_API_URL=http://127.0.0.1:8010

# Optional compatibility flag for navigation outside the object screen.
# The object screen keeps the pilot layout (today, issues, procurement, money, quality).
# Enabled company features add more-menu tabs. Demo mode uses the full screen. This variable is not required for that screen.
# Next.js reads this at build and dev start.
NEXT_PUBLIC_PILOT_MODE=1
