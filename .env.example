NEXT_PUBLIC_API_URL=http://localhost:8010
API_PORT=8010
DATABASE_URL=postgresql://superapp:superapp@localhost:5432/superapp
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0

# development or production. production refuses to start without the two values below.
ANYQ_ENV=development
# Required in production. At least 32 characters. No default is shipped in code.
JWT_SECRET=
# Comma-separated browser origins. Required in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional password for local @demo.superapp accounts. Ignored when ANYQ_ENV=production.
ANYQ_DEMO_PASSWORD=
LEGAL_PD_VERSION=2026-10-18
