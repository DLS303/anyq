# Values the API and web actually read. Leave secrets empty. Do not put real data here.

# development or production. production refuses to start without JWT_SECRET and CORS_ORIGINS.
ANYQ_ENV=development

# HMAC secret for session tokens. Required in production, at least 32 characters. No default in code.
JWT_SECRET=
# Older name still accepted if JWT_SECRET is empty.
SUPERAPP_SECRET=

# Comma-separated browser origins. Required in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Read into settings; the pilot store is still the JSON file below.
DATABASE_URL=

# JSON store path. Empty uses data/db.json next to the repo.
ANYQ_DB_PATH=
# Uploaded files. Empty uses data/uploads.
ANYQ_UPLOADS_DIR=

# Optional password for local @demo.superapp accounts. Ignored when ANYQ_ENV=production.
ANYQ_DEMO_PASSWORD=

# Version string written into the personal-data consent log.
LEGAL_PD_VERSION=2026-10-18
# Directory with the published legal markdown. Empty uses the repo legal/ folder.
LEGAL_DIR=

# Server-side base URL the Next.js app uses to reach the API. The browser calls same-origin /v1.
INTERNAL_API_URL=http://127.0.0.1:8010
